{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DH BOT Dev",
  "identifier": "cloud.daha6.dhbot.dev",
  "build": {
    "beforeDevCommand": "pnpm dev:developer",
    "beforeBuildCommand": "pnpm build:developer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DH BOT Dev",
        "width": 1320,
        "height": 840,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.ico",
      "tooltip": "DH BOT Dev"
    }
  },
  "bundle": {
    "resources": ["resources/tools/*"]
  }
}
